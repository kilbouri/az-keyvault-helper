<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyVaultHelper.ViewModels"
             x:Class="KeyVaultHelper.Views.SelectableSecretView"
             x:DataType="vm:SelectableSecretViewModel">
    <DockPanel>
        <CheckBox DockPanel.Dock="Left"
                  IsChecked="{Binding IsSelected}"
                  VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SecretName}"
                   VerticalAlignment="Center"/>
    </DockPanel>
</UserControl>
