<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyVaultHelper.ViewModels"
             xmlns:v="using:KeyVaultHelper.Views"
             x:Class="KeyVaultHelper.Views.KeyVaultTabView"
             x:DataType="vm:KeyVaultTabViewModel">
    <DockPanel>
        <!-- Breadcrumb -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding BreadcrumbPath}"/>
    </DockPanel>
</UserControl>
