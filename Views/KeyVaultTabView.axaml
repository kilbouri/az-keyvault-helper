<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KeyVaultHelper.ViewModels"
             xmlns:v="using:KeyVaultHelper.Views"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:conv="using:KeyVaultHelper.Converters"
             x:Class="KeyVaultHelper.Views.KeyVaultTabView"
             x:DataType="vm:KeyVaultTabViewModel">
    <UserControl.Resources>
        <conv:RelativeDateTimeConverter x:Key="RelativeDateTimeConverter"/>
        <conv:AbsoluteDateTimeConverter x:Key="AbsoluteDateTimeConverter"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Breadcrumb -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding BreadcrumbPath}" Margin="12,12,12,0" FontSize="12" Foreground="#666666"/>

        <!-- Loading Indicator -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsLoadingSecrets}"
                Background="#F0F0F0"
                CornerRadius="4"
                Margin="12,12,12,0"
                Padding="12">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding LoadingMessage}"
                           Foreground="#666666"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Error Indicator -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding SecretLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#FFE6E6"
                CornerRadius="4"
                Margin="12,12,12,0"
                Padding="12"
                BorderThickness="1"
                BorderBrush="#FF9999">
            <StackPanel>
                <TextBlock Text="{Binding SecretLoadError}"
                           Foreground="#CC0000"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Secrets Table -->
        <dg:DataGrid ItemsSource="{Binding Secrets}"
                     IsEnabled="{Binding !IsLoadingSecrets}"
                     AutoGenerateColumns="False"
                     CanUserReorderColumns="False"
                     CanUserResizeColumns="True"
                     CanUserSortColumns="True"
                     Margin="12,12,12,12">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Secret Name"
                                       Binding="{Binding Name}"
                                       IsReadOnly="True"
                                       Width="*"/>
                <dg:DataGridTextColumn Header="Content Type"
                                       Binding="{Binding ContentType}"
                                       IsReadOnly="True"
                                       Width="200"/>
                <dg:DataGridTemplateColumn Header="Last Modified" Width="180" IsReadOnly="True">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastModifiedDate, Converter={StaticResource RelativeDateTimeConverter}}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding LastModifiedDate, Converter={StaticResource AbsoluteDateTimeConverter}}"/>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>
                <dg:DataGridTemplateColumn Header="Expiry Date" Width="180" IsReadOnly="True">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ExpiryDate, Converter={StaticResource RelativeDateTimeConverter}}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding ExpiryDate, Converter={StaticResource AbsoluteDateTimeConverter}}"/>
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </DockPanel>
</UserControl>
