<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeyVaultHelper.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="KeyVaultHelper.Views.OpenVaultDialog"
        x:DataType="vm:OpenVaultDialogViewModel"
        Title="Open Vault"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Width="500"
        SizeToContent="Height"
        MinHeight="300">

    <StackPanel Margin="20">
        <!-- Subscription Selector -->
        <StackPanel Margin="0,0,0,12" IsEnabled="{Binding !IsLoadingResources}">
            <TextBlock Text="Subscription" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Subscriptions}"
                      DisplayMemberBinding="{Binding Name}"
                      SelectedItem="{Binding SelectedSubscription}"
                      PlaceholderText="Select a subscription..." />
        </StackPanel>

        <!-- Resource Group Selector -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Resource Group" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding FilteredResourceGroups}"
                      DisplayMemberBinding="{Binding Name}"
                      SelectedItem="{Binding SelectedResourceGroup}"
                      PlaceholderText="Select a resource group..."
                      IsEnabled="{Binding HasSelectedSubscription}" />
        </StackPanel>

        <!-- Vault Selector -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Key Vault" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding FilteredVaults}"
                      SelectedItem="{Binding SelectedVault}"
                      DisplayMemberBinding="{Binding Id}"
                      PlaceholderText="Select a key vault..."
                      IsEnabled="{Binding HasSelectedResourceGroup}" />
        </StackPanel>

        <!-- Buttons -->
        <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Content="Cancel"
                    Grid.Column="1"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="OnCancelClick"
                    IsEnabled="{Binding !IsLoadingResources}"/>
            <Button Content="Open"
                    Grid.Column="2"
                    Width="100"
                    IsEnabled="{Binding HasSelectedVault}"
                    Click="OnOpenClick" />
        </Grid>
    </StackPanel>
</Window>
